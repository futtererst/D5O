# RybexOS environment example
#
# Seed mode is the default and does not require database variables.
RYBEXOS_DATA_SOURCE=seed

# Auth remains demo-only by default. Supabase auth is a future foundation mode.
RYBEXOS_AUTH_MODE=demo

# Workflow transactions remain local/demo state by default.
RYBEXOS_WORKFLOW_TRANSACTION_STORE=local

# Workflow completions remain local/demo state by default.
RYBEXOS_WORKFLOW_COMPLETION_STORE=local

# Evidence actions remain local/demo state by default.
RYBEXOS_EVIDENCE_STORE=local

# Production readiness requires explicit, verified persistence and scanner modes.
# Set these only after the matching database schema and scanner service are qualified.
# RYBEXOS_BILLING_V2_PERSISTENCE=database
# RYBEXOS_FIELD_ISSUE_PERSISTENCE=database
# RYBEXOS_CLOSEOUT_FINAL_BILLING_PERSISTENCE=database
# RYBEXOS_SCANNER_MODE=local_service
# RYBEXOS_SCANNER_URL=<verified-scanner-service-url>

# To test the database read pilot locally:
# RYBEXOS_DATA_SOURCE=database
# RYBEXOS_WORKFLOW_TRANSACTION_STORE=local
#
# To test the workflow transaction write pilot locally:
# RYBEXOS_DATA_SOURCE=database
# RYBEXOS_WORKFLOW_TRANSACTION_STORE=database
#
# To test the workflow completion persistence pilot locally:
# RYBEXOS_DATA_SOURCE=database
# RYBEXOS_WORKFLOW_COMPLETION_STORE=database
#
# To test the evidence upload pilot locally:
# RYBEXOS_DATA_SOURCE=database
# RYBEXOS_EVIDENCE_STORE=database

# Future Supabase variables. Leave blank in seed mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Compatibility aliases supported by the database pilot.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this key to client-side code.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional external crew booking alerts in the isolated D5O prototype.
# Workers opt in per channel under /work/settings. Email/phone must already be
# verified on the signed-in Auth account; synthetic .local addresses are excluded.
# Never put provider secrets in NEXT_PUBLIC_* variables or commit real values.
D5O_RESEND_API_KEY=
D5O_EMAIL_FROM=
D5O_TWILIO_ACCOUNT_SID=
D5O_TWILIO_AUTH_TOKEN=
D5O_TWILIO_MESSAGING_SERVICE_SID=
# Alternative to a Messaging Service SID:
D5O_TWILIO_FROM=
D5O_VAPID_PUBLIC_KEY=
D5O_VAPID_PRIVATE_KEY=
D5O_VAPID_SUBJECT=
